# heather_m: a clump of pink mountain heather (BUILD_PLAN S5 brief B5):
# alpenglow pink (6) bells over moss (13), sage (14) tips. The anchor, 0,0,
# is its foot, at the middle. 9 wide, 3 tall.
C 13  L -2,-1 -2,0  L 2,-1 2,0  L -4,0  L 0,0  L 4,0
C 6  L 2,-2  L -3,-1 -3,0  L -1,-1 -1,0  L 1,-1 1,0  L 3,-1 3,0
C 14  L -1,-2  L 0,-1
