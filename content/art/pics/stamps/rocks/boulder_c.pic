# boulder_c: a big boulder (BUILD_PLAN S5 brief B5): two blocks of slate (2)
# split by a night-navy (1) fissure that runs from its top to its foot, a
# line and never a dot, their top-right facets lit glacier blue (3), an ink
# (0) ground line. Drawn row by row as whole shapes, so nothing reads as an
# eye. The anchor, 0,0, is the middle of its ground line. 14 wide, 8 tall.
C 2  L -2,-7 -1,-7  L -4,-6 -1,-6  L -5,-5 -2,-5  L -6,-4 -3,-4  L -6,-3 -3,-3
      L -7,-2 -4,-2  L -7,-1 -3,-1  L -1,-4 1,-4  L -1,-3 2,-3  L -2,-2 2,-2
      L -2,-1 3,-1
C 1  L 0,-7 0,-6  L -1,-5  L -2,-4 -2,-3  L -3,-2  L -3,-1 -2,-1
C 3  L 1,-7 2,-7  L 1,-6 4,-6  L 0,-5 5,-5  L 2,-4 5,-4  L 3,-3 6,-3
      L 3,-2 6,-2  L 4,-1 6,-1
C 0  L -7,0 6,0
