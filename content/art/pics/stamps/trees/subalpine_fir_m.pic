# subalpine_fir_m: a fir in the middle distance.
# Stacked tiers (doc 11.1): the shadow side in spruce (11) on the left, the
# lit side in forest (12) on the right, for evening light from the west.
# The anchor, 0,0, is the foot of the trunk. 13 wide, 40 tall, 6 tiers.
C 10
L 0,0 0,-2
# tier 6
C 11  L -2,-30 0,-39 0,-30 -2,-30
F -1,-32
C 12  L 1,-38 2,-30 1,-30 1,-38
# tier 5
C 11  L -3,-24 0,-33 0,-24 -3,-24
F -1,-28
C 12  L 1,-32 3,-24 1,-24 1,-32
F 2,-26
# tier 4
C 11  L -4,-19 0,-28 0,-19 -4,-19
F -1,-23
C 12  L 1,-27 4,-19 1,-19 1,-27
F 2,-23
# tier 3
C 11  L -5,-14 0,-23 0,-14 -5,-14
F -2,-18
C 12  L 1,-22 5,-14 1,-14 1,-22
F 2,-18
# tier 2
C 11  L -6,-8 0,-17 0,-8 -6,-8
F -2,-13
C 12  L 1,-16 6,-8 1,-8 1,-16
F 2,-13
# tier 1
C 11  L -7,-3 0,-12 0,-3 -7,-3
F -3,-7
C 12  L 1,-11 7,-3 1,-3 1,-11
F 2,-7
