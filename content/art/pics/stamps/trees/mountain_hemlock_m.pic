# mountain_hemlock_m: a hemlock in the middle distance.
# Like the firs' stacked tiers but softer and less regular (doc 11.1;
# BUILD_PLAN S5 brief B5): each tier droops, its base sloping down from
# the trunk to its outer tip, and the leader bends over to one side, the
# hemlock's tell. Shadow side spruce (11) on the left, lit side forest (12)
# on the right (the day's sun is high in the south-west). The anchor, 0,0,
# is the foot of the trunk. 13 wide, 35 tall, 5 tiers.
C 10
L 0,0 0,-3
L 1,0 1,-3
# the leader, nodding over: two pixels thick, bent over at its tip, joined
# to the crown.
C 11  L 0,-29 0,-34  L -1,-34  L -2,-33
C 12  L 1,-29 1,-32
# tier 5
C 11  L 0,-30 -2,-24 0,-25 0,-30
F -1,-25
C 12  L 1,-29 2,-24 1,-25 1,-29
# tier 4
C 11  L 0,-27 -3,-19 0,-20 0,-27
F -1,-22 -2,-20
C 12  L 1,-26 3,-19 1,-20 1,-26
F 2,-20
# tier 3
C 11  L 0,-23 -4,-14 0,-15 0,-23
F -2,-16
C 12  L 1,-22 5,-14 1,-15 1,-22
F 2,-16
# tier 2
C 11  L 0,-19 -6,-9 0,-10 0,-19
F -1,-12
C 12  L 1,-18 5,-9 1,-10 1,-18
F 2,-11
# tier 1
C 11  L 0,-14 -5,-4 0,-5 0,-14
F -1,-7
C 12  L 1,-13 6,-4 1,-5 1,-13
F 3,-7
