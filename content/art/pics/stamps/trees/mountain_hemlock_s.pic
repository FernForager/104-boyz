# mountain_hemlock_s: a small hemlock in the middle distance.
# Like the firs' stacked tiers but softer and less regular (doc 11.1;
# BUILD_PLAN S5 brief B5): each tier droops, its base sloping down from
# the trunk to its outer tip, and the leader bends over to one side, the
# hemlock's tell. Shadow side spruce (11) on the left, lit side forest (12)
# on the right (the day's sun is high in the south-west). The anchor, 0,0,
# is the foot of the trunk. 7 wide, 19 tall, 3 tiers.
C 10
L 0,0 0,-2
# the leader, nodding over, joined to the crown.
C 11  L 0,-14 0,-18  L -1,-18
C 12  L 1,-14 1,-16
# tier 3
C 11  L 0,-15 -1,-10 0,-11 0,-15
C 12  L 1,-14 1,-10 1,-11 1,-14
# tier 2
C 11  L 0,-13 -2,-6 0,-7 0,-13
F -1,-7
C 12  L 1,-12 2,-6 1,-7 1,-12
# tier 1
C 11  L 0,-10 -3,-2 0,-3 0,-10
F -1,-4 -2,-3
C 12  L 1,-9 3,-2 1,-3 1,-9
F 2,-3
