# subalpine_fir_l: a tall fir near the viewer.
# Stacked tiers (doc 11.1): the shadow side in spruce (11) on the left, the
# lit side in forest (12) on the right, for evening light from the west.
# The anchor, 0,0, is the foot of the trunk. 20 wide, 72 tall, 7 tiers.
C 10
L 0,0 0,-3
L 1,0 1,-3
# tier 7
C 11  L -2,-53 0,-66 0,-53 -2,-53
F -1,-56
C 12  L 1,-65 2,-53 1,-53 1,-65
# tier 6
C 11  L -3,-45 0,-58 0,-45 -3,-45
F -1,-51
C 12  L 1,-57 3,-45 1,-45 1,-57
F 2,-48
# tier 5
C 11  L -5,-37 0,-50 0,-37 -5,-37
F -1,-44
C 12  L 1,-49 5,-37 1,-37 1,-49
F 2,-44
# tier 4
C 11  L -6,-29 0,-42 0,-29 -6,-29
F -2,-36
C 12  L 1,-41 6,-29 1,-29 1,-41
F 2,-36
# tier 3
C 11  L -7,-20 0,-33 0,-20 -7,-20
F -2,-28
C 12  L 1,-32 7,-20 1,-20 1,-32
F 2,-28
