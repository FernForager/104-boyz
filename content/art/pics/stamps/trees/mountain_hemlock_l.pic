# mountain_hemlock_l: a big hemlock framing a near view.
# Like the firs' stacked tiers but softer and less regular (doc 11.1;
# BUILD_PLAN S5 brief B5): each tier droops, its base sloping down from
# the trunk to its outer tip, and the leader bends over to one side, the
# hemlock's tell. Shadow side spruce (11) on the left, lit side forest (12)
# on the right (the day's sun is high in the south-west). The anchor, 0,0,
# is the foot of the trunk. 19 wide, 53 tall, 7 tiers.
C 10
L 0,0 0,-4
L 1,0 1,-4
# the leader, nodding over: two pixels thick, the shadow side and the lit,
# its last two pixels bent over to the left, all joined to the crown.
C 11  L 0,-46 0,-52  L -1,-52  L -2,-51
C 12  L 1,-46 1,-50
# tier 7
C 11  L 0,-47 -2,-40 0,-41 0,-47
F -1,-41
C 12  L 1,-46 2,-40 1,-41 1,-46
# tier 6
C 11  L 0,-44 -3,-35 0,-36 0,-44
F -1,-38 -2,-36
C 12  L 1,-43 4,-35 1,-36 1,-43
F 2,-38 3,-36
# tier 5
C 11  L 0,-40 -5,-30 0,-31 0,-40
F -1,-33
C 12  L 1,-39 4,-30 1,-31 1,-39
F 2,-33 3,-31
# tier 4
C 11  L 0,-35 -6,-24 0,-25 0,-35
F -2,-27
C 12  L 1,-34 6,-24 1,-25 1,-34
F 3,-27
# tier 3
C 11  L 0,-30 -7,-18 0,-19 0,-30
F -3,-21
C 12  L 1,-29 8,-18 1,-19 1,-29
F 3,-21
# tier 2
C 11  L 0,-24 -9,-12 0,-13 0,-24
F -4,-15
C 12  L 1,-23 8,-12 1,-13 1,-23
F 3,-15
# tier 1
C 11  L 0,-18 -8,-5 0,-6 0,-18
F -1,-9
C 12  L 1,-17 9,-5 1,-6 1,-17
F 2,-8
