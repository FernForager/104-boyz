# krummholz_b: a longer wind-flattened fir mat (BUILD_PLAN S5 brief B5):
# spruce (11) underneath, forest (12) on top, two upright tips leaning out of
# it. The anchor, 0,0, is its foot, at the middle. 14 wide, 6 tall.
C 11  L -7,-2 -7,-1  L -7,0 6,0
C 12  L -4,-5  L -5,-4 -4,-4  L 4,-4  L -6,-3 -2,-3  L 3,-3 5,-3
      L -6,-2 6,-2  L -6,-1 6,-1
