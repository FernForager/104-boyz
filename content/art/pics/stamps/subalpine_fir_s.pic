# subalpine_fir_s: a small fir on the crest.
# Stacked tiers (doc 11.1): the shadow side in spruce (11) on the left, the
# lit side in forest (12) on the right, for evening light from the west.
# The anchor, 0,0, is the foot of the trunk. 9 wide, 22 tall, 4 tiers.
C 10
L 0,0 0,-1
# tier 4
C 11  L -2,-15 0,-22 0,-15 -2,-15
F -1,-16
C 12  L 1,-21 2,-15 1,-15 1,-21
# tier 3
C 11  L -3,-11 0,-18 0,-11 -3,-11
F -1,-14
C 12  L 1,-17 3,-11 1,-11 1,-17
F 2,-12
# tier 2
C 11  L -4,-6 0,-13 0,-6 -4,-6
F -1,-10
C 12  L 1,-12 4,-6 1,-6 1,-12
F 2,-9
# tier 1
C 11  L -5,-2 0,-9 0,-2 -5,-2
F -2,-5
C 12  L 1,-8 5,-2 1,-2 1,-8
F 2,-5
