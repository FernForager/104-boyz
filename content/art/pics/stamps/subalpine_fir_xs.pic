# subalpine_fir_xs: a far fir, a few pixels tall.
# Stacked tiers (doc 11.1): the shadow side in spruce (11) on the left, the
# lit side in forest (12) on the right, for evening light from the west.
# The anchor, 0,0, is the foot of the trunk. 5 wide, 11 tall, 3 tiers.
C 10
L 0,0 0,-1
# tier 3
C 11  L -1,-8 0,-13 0,-8 -1,-8
C 12  L 1,-12 1,-8 1,-8 1,-12
# tier 2
C 11  L -2,-5 0,-10 0,-5 -2,-5
F -1,-6
C 12  L 1,-9 2,-5 1,-5 1,-9
# tier 1
C 11  L -3,-2 0,-7 0,-2 -3,-2
F -1,-4
C 12  L 1,-6 3,-2 1,-2 1,-6
F 2,-3
