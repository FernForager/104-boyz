# subalpine_fir_xl: a big framing fir for the edge of a plate.
# Stacked tiers (doc 11.1): the shadow side in spruce (11) on the left, the
# lit side in forest (12) on the right, for evening light from the west.
# The anchor, 0,0, is the foot of the trunk. 32 wide, 132 tall, 9 tiers.
C 10
L -1,0 -1,-4
L 0,0 0,-4
L 1,0 1,-4
# tier 9
C 11  L -3,-99 0,-118 0,-99 -3,-99
F -1,-108
C 12  L 1,-117 3,-99 1,-99 1,-117
F 2,-103
# tier 8
C 11  L -4,-87 0,-106 0,-87 -4,-87
F -1,-98
C 12  L 1,-105 4,-87 1,-87 1,-105
F 2,-96
# tier 7
C 11  L -6,-75 0,-94 0,-75 -6,-75
F -2,-86
C 12  L 1,-93 6,-75 1,-75 1,-93
F 2,-86
# tier 6
C 11  L -8,-64 0,-83 0,-64 -8,-64
F -3,-74
C 12  L 1,-82 8,-64 1,-64 1,-82
F 2,-74
# tier 5
C 11  L -9,-52 0,-71 0,-52 -9,-52
F -3,-63
C 12  L 1,-70 9,-52 1,-52 1,-70
F 2,-63
# tier 4
C 11  L -11,-40 0,-59 0,-40 -11,-40
F -4,-51
C 12  L 1,-58 11,-40 1,-40 1,-58
F 2,-51
# tier 3
C 11  L -13,-28 0,-47 0,-28 -13,-28
F -4,-39
C 12  L 1,-46 13,-28 1,-28 1,-46
F 2,-39
# tier 2
C 11  L -14,-17 0,-36 0,-17 -14,-17
F -6,-27
C 12  L 1,-35 14,-17 1,-17 1,-35
F 2,-27
# tier 1
C 11  L -16,-5 0,-24 0,-5 -16,-5
F -6,-16
C 12  L 1,-23 16,-5 1,-5 1,-23
F 2,-16
