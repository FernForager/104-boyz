      2,-15 0,-17 -2,-17 -4,-16 -5,-14 -7,-13 -10,-13 -12,-13
      -12,-11 -10,-9 -11,-8 -12,-7 -13,-5 -11,-4 -8,-3 -7,-3
      -6,-1 -5,-1 -2,-1 0,-1 2,-1 4,-1 7,-1 9,-1
      9,-3 9,-5 11,-5 13,-6 13,-8
C 13  F 0,-8
C 12  L -10,-4 -6,-3 -2,-4 2,-3 7,-4 11,-5
C 12  F 0,-2
C 14  L 4,-10 3,-11 1,-12 1,-13 0,-14 -2,-14 -4,-13 -5,-13
      -7,-13 -9,-12 -8,-11 -8,-10 -9,-9 -9,-8 -7,-8 -5,-8
      -4,-7 -2,-7 0,-7 0,-8 1,-9 3,-9 4,-10
