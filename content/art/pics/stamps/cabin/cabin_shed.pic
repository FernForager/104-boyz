# cabin_shed: the small shed beside the cabin, matching it: the same steep
# gable and board-and-batten cedar (brick with bark battens), one small
# window high in its gable, a plank door with a light over it, a slate
# metal edge on its rakes and its right roof plane showing. Set back to the
# cabin's right, so it stands on the mid layer, behind the cabin's eave.
# The anchor, 0,0, is the middle of its foot. 35 wide, 58 tall.
# the rakes: a slate edge over bark fascia; the right roof plane above its rake
C 11  L 1,-58 17,-33  L 17,-33 17,-31
C 2  L 0,-57 -17,-30  L 0,-57 17,-30
C 10  L 0,-56 -17,-29  L 0,-55 -17,-28  L 0,-56 17,-29  L 0,-55 17,-28
D 11 13 checker25  F 14,-36 10,-42
# the gable wall in the overhang's shadow, then the wall itself
C 0  L 0,-54 -14,-32  L 0,-54 14,-32
C 9  L -14,-31 -14,0 14,0 14,-31
# the little window high in the gable: a bark frame, dark panes, a glint
C 10  L -3,-45 3,-45 3,-38 -3,-38 -3,-45
C 2  F -1,-42 1,-42
C 0  L 0,-44 0,-39  L -2,-44 2,-44
C 3  L -2,-41 -1,-42  L 1,-40 2,-41
# the plank door, its planks seamed in ink, a bark casing
C 10  L -9,-17 7,-17  L -9,-17 -9,0  L 7,-17 7,0
C 10  L -8,-16 6,-16 6,0 -8,0 -8,-16
C 10  F -1,-8
C 0  L -5,-15 -5,-1  L -2,-15 -2,-1  L 1,-15 1,-1  L 4,-15 4,-1  L -7,-8 5,-8
# the light over the door
C 0  L -2,-19 0,-19
C 5  L -1,-18
# the wall, and its battens every third column
C 9  F -11,-20
C 10  L -12,-32 -12,-1  L -9,-36 -9,-20  L -6,-41 -6,-20  L -3,-46 -3,-46  L -3,-37 -3,-20  L 0,-50 0,-46  L 0,-37 0,-20  L 3,-46 3,-46  L 3,-37 3,-20  L 6,-41 6,-20  L 9,-36 9,-1  L 12,-32 12,-1
C 0  L -14,-1 14,-1  L -13,-30 -13,-1
