# sitka_tier_05: tier 5 of the Sitka spruce (sitka_spruce), 14
# columns across: its top falls from the trunk to drooping tips, lit on
# top (forest), a deep band on the left (light from the upper left) and a
# rim on the right; shade beneath (spruce), its underside rising back to
# the trunk. A stamp of its own, so the tier above lays over it. The
# anchor, 0,0, is the tier's top at the trunk's left column.
C 12  L 0,0 1,0 4,3 7,11 6,11 4,4 1,2 0,6 -3,7 -4,11 -6,12 -3,3 0,0
C 12  F -3,6
C 11  L -4,12 -3,11 0,10 1,10 4,11 5,11 6,10 4,5 1,3 1,6 0,7 -3,8 -4,12
C 11  F 3,8 0,9
