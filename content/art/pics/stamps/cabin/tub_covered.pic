# tub_covered: the round green inflatable tub at the porch's right corner,
# covered and cold (GAME_DESIGN 2.2, 11.11): a low upright cylinder seen
# from the front and a little above. Its cover an ellipse 25 columns by 5
# rows, lit sage on its upper left, moss elsewhere, forest along its back
# rim; under its front edge the overhang's shadow; its short body below,
# shaded lit on the left to dark on the right (sage, moss, forest, spruce;
# a moss edge on its far left, so it stands off the sunlit lawn), a dark
# base line along its round foot, which bows lower in the middle and steps
# in at each end; on its own small low deck (the porch's silvered wood)
# with two bark steps up its left side, their treads lit along the top
# (brick), standing on the deck. The anchor, 0,0, is the middle of the low
# deck's foot. 35 wide, 18 tall.
# the low deck
C 3  L -18,-3 16,-3
C 2  L -18,-2 16,-2  L -18,-1 16,-1
C 0  L -18,0 16,0
C 12  L 3,-11 7,-11 7,-5 3,-5 3,-11  F 4,-10
      L -9,-17 9,-17  L -12,-16 -10,-16  L 10,-16 12,-16  L -12,-13 -10,-13  L -9,-12 7,-12
C 14  L -11,-11 -9,-11 -9,-6 -11,-6 -11,-11  F -10,-10
      L -9,-16 -3,-16  L -12,-15 -3,-15  L -11,-12 -10,-12  L -9,-5
C 13  L -8,-11 2,-11 2,-5 -8,-5 -8,-11  F -7,-10
      L -2,-16 9,-16  L -2,-15 12,-15  L -12,-14 12,-14  L -9,-13 9,-13  L -12,-12  L -12,-11
      L -12,-10  L -12,-9  L -12,-8  L -12,-7
C 11  L 8,-12 12,-12 12,-7 8,-7 8,-12  F 9,-11
      L 10,-13 12,-13  L 8,-6 11,-6  L 8,-5 9,-5
C 0  L -12,-6  L 12,-6  L -11,-5 -10,-5  L 10,-5 11,-5  L -9,-4 9,-4
# two steps up its left side, standing on the deck: bark, their treads lit
C 9  L -18,-7 -13,-7  L -16,-11 -13,-11
C 10  L -18,-6 -13,-6  L -18,-5 -13,-5  L -18,-4 -13,-4  L -16,-10 -13,-10  L -16,-9 -13,-9  L -16,-8 -13,-8
