# tub_covered: the round green inflatable tub at the porch's right corner,
# covered and cold (GAME_DESIGN 2.2, 11.11): its cover a forest (12) disc
# seen a little from above, strapped down, catching the light on its near
# edge; its body two puffed moss (13) rings, lit on the left (sage), in
# shade on the right (forest), a dark seam between them and under its
# lip; on its own small low deck (the porch's silvered wood) with two
# little bark steps at its left. The anchor, 0,0, is the middle of the low
# deck's foot. 37 wide, 20 tall.
# the low deck
C 3  L -18,-3 16,-3
C 2  L -18,-2 16,-2  L -18,-1 16,-1
C 0  L -18,0 16,0
# the cover, a disc seen from a little above
C 12  L -6,-19 6,-19 10,-18 12,-17 12,-16 -12,-16 -12,-17 -10,-18
      -6,-19
C 12  F 0,-17
C 14  L -9,-17 -4,-17  L -11,-16 -6,-16
C 11  L 5,-18 9,-17  L -1,-19 -1,-16  L 4,-19 6,-16
C 0  L -12,-15 12,-15
# the body: two puffed rings, rounded at their ends
C 12  L -12,-14 12,-14 13,-13 13,-11 12,-10 13,-9 13,-6 11,-4
      -11,-4 -13,-6 -13,-9 -12,-10 -13,-11 -13,-13 -12,-14
C 13  F 0,-12 0,-7
C 12  L -12,-10 12,-10
C 14  L -11,-13 -11,-11  L -10,-13 -6,-13  L -12,-9 -12,-6  L -11,-9 -7,-9  L -10,-5 -9,-5
C 12  L 7,-13 11,-13  L 8,-12 12,-12  L 10,-11 12,-11  L 6,-9 11,-9  L 8,-8 12,-8  L 9,-7 12,-7  L 9,-6 12,-6  L 8,-5 10,-5
# two little steps up its left side
C 10  L -20,-6 -15,-6  L -18,-10 -14,-10
C 0  L -20,-5 -15,-5  L -20,-4 -15,-4  L -18,-9 -14,-9  L -18,-8 -14,-8  L -18,-7 -14,-7
