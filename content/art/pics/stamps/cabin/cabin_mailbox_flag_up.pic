# cabin_mailbox_flag_up: the mailbox's flag raised: an update waits
# (GAME_DESIGN 2.2, 12.18). Moss (13) paints out the flag lying down on the
# grass beside the box; the rust (8) flag stands up over the box's back.
# The anchor, 0,0, is at_mailbox_flag, the lowered flag's pivot.
C 13  L 0,-1 0,1
C 2  L -1,0
C 8  L 0,-8 1,-8  L 0,-7 1,-7  L 0,-6 1,-6  L 0,-5 0,-3
C 0  L 0,-2
