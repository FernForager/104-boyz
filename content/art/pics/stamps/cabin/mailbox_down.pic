# mailbox_down: the rural mailbox at the lawn's bottom right, on a bark
# post: a slate (2) box with a rounded top, its rust (8) flag down along
# its right side. The anchor, 0,0, is the post's foot. 13 wide, 24 tall.
C 10  L -1,-15 -1,0  L 0,-15 0,0
C 2  L -6,-16 -6,-21 -5,-23 4,-23 5,-21 5,-16 -6,-16
C 2  F 0,-19
C 3  L -5,-22 3,-22
C 0  L -6,-16 5,-16  L -6,-21 -6,-17
C 8  L 6,-19 6,-17  L 5,-18
