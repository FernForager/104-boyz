# clam_shovel: the clam shovel, leaning on the shed's front by its door
# (decision 61: a shovel, never a gun): a pale wooden D-grip and shaft
# (paper cream) with its shaded side in bark, an ink edge where the shaft
# lies across the bark door so it stands off it, and a short metal blade
# (slate, one glint of glacier blue on its lit edge), its tip in the grass.
# The anchor, 0,0, is the blade's tip. 4 wide, 20 tall.
C 5  L 0,-19 2,-19  L 0,-18  L 2,-18  L 1,-17  L 1,-16 1,-12  L 0,-11 0,-6
C 10  L 2,-17
C 0  L 2,-16 2,-12  L 1,-11 1,-6
C 2  L -1,-5 0,-5  L -1,-4 0,-4  L -1,-3 0,-3  L -1,-2 0,-2  L -1,-1 0,-1  L -1,0 0,0
C 3  L -1,-4 -1,-3
