# adirondack_chair: a pale blue-gray Adirondack chair on the porch, seen
# from the front (GAME_DESIGN 11.11): a fan of back slats (glacier blue
# with slate gaps), flat arms the chair's full width, the seat's shadow and
# four plain legs. The anchor, 0,0, is between its front feet. 9 wide, 10
# tall.
C 3  L -1,-9 1,-9  L -2,-8 -2,-5  L 0,-8 0,-5  L 2,-8 2,-5  L -4,-4 4,-4
C 2  L -1,-8 -1,-5  L 1,-8 1,-5  L -2,-3 2,-3  L -4,-3 -4,0  L 4,-3 4,0
