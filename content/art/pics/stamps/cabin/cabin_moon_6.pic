# cabin_moon_6: the moon at the last quarter (6 eighths of its month), lit on the left while waning
# (lead call 54). Lamp light (24), so it stays bright at night; the dark
# limb isn't drawn, the sky shows there. The anchor, 0,0, is the
# disc's center (at_moon). 7 wide, 7 tall.
C 24  L -1,-3 0,-3  L -2,-2 0,-2  L -3,-1 0,-1  L -3,0 0,0  L -3,1 0,1  L -2,2 0,2
      L -1,3 0,3
