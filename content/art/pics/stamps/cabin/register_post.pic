# register_post: the old trail's register box on its post at the lawn's
# edge (GAME_DESIGN 2.2, 9.8): the trailhead box's look, a brick (9) box
# with a bark (10) frame and a slanted lid, a pencil on a string. The
# anchor, 0,0, is the foot of the post. 12 wide, 41 tall.
C 10  L -1,-30 -1,0  L 0,-30 0,0
C 0  L 1,-29 1,0
C 10  L -5,-36 4,-36 4,-30 -5,-30 -5,-36
C 9  F 0,-33
C 10  L -6,-37 5,-40  L -6,-38 5,-41
C 0  L -5,-31 4,-31
C 2  L 5,-33  L 5,-31  L 6,-29
C 5  L 6,-28 6,-26
