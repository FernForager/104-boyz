# register_post: the old trail's register on its post at the lawn's edge
# (GAME_DESIGN 2.2, 9.8), the trailhead box's look: an upright box taller
# than wide (brick in a bark frame), a slanted bark lid overhanging its
# front with its shadow under it, a dark door with a speck of paper tucked
# by it, and a pencil hanging on its string from the side. The anchor, 0,0,
# is the foot of the post. 7 wide, 40 tall.
# the post, lit on its left, shaded on its right
C 10  L -1,-27 -1,0  L 0,-27 0,0
C 0  L 1,-26 1,0
# the box, its frame and its body
C 10  L -2,-36 2,-36 2,-27 -2,-27 -2,-36
C 9  F 0,-31
# the lid, slanted, overhanging the box's front, and its shadow
C 10  L -2,-39 2,-39  L -3,-38 3,-38  L -3,-37 3,-37
C 0  L -1,-36 2,-36
# the door, dark, a speck of paper in its slot
C 0  L -1,-34 0,-34  L -1,-33 0,-33  L -1,-32 0,-32  L -1,-31 0,-31  L -1,-30 0,-30
C 5  L 1,-30
# the pencil on its string, hanging from the side
C 2  L 3,-35 3,-31
C 5  L 3,-30 3,-28
C 0  L 3,-27
