# mole_hill_l: a big mole hill in the foreground: a heaped, rounded mound,
# its lit top brick on the upper left, its body bark, an ink foot where it
# meets the grass, longer on the shaded right. The anchor, 0,0, is its
# foot's middle. 10 wide, 4 tall.
C 9  L -1,-3 0,-3  L -3,-2 -1,-2  L -4,-1 -3,-1
C 10  L 1,-3  L 0,-2 3,-2  L -2,-1 4,-1
C 0  L -4,0 5,0
