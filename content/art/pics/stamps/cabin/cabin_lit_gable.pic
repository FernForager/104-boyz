# cabin_lit_gable: the tall arched window high in the gable, lit at night:
# the warm eye at the top of the cabin (decision 38). The whole fanlight
# lamp light, its three muntins ink, fanning from a hub at the transom
# bar's middle; the casements lamp light, the loft's rail across their foot
# (an ink top rail and four balusters), the lower left pane clear above it
# for at_lily_sketch. Its light catches the truss above: spill (28) along
# the tie beam's underside and at the king post's foot, so the apex never
# goes ink on ink. The anchor, 0,0, is at_win_gable, the arch's crown.
C 24  L -7,10 -1,10 -1,29 -7,29 -7,10  F -6,11
      L 1,10 7,10 7,29 1,29 1,10  F 2,11
      L -2,1 -1,1  L 1,1 2,1  L -4,2 -1,2  L 1,2 4,2  L -4,3 -1,3  L 1,3 4,3
      L -6,4 -1,4  L 1,4 3,4  L 5,4 6,4  L -7,5 -4,5  L -2,5 -1,5  L 1,5 2,5
      L 4,5 7,5  L -7,6 -3,6  L -1,6  L 1,6  L 3,6 7,6  L -7,7 -2,7
      L 2,7 7,7  L -7,31 -6,31  L -4,31 -3,31  L -1,31  L 1,31  L 3,31 4,31
      L 6,31 7,31  L -7,32 -6,32  L -4,32 -3,32  L -1,32  L 1,32  L 3,32 4,32
      L 6,32 7,32
C 0  L -7,30 -1,30  L 1,30 7,30  L -5,31  L -2,31  L 2,31  L 5,31
      L -5,32  L -2,32  L 2,32  L 5,32
C 0  L 0,7 0,1  L -1,7 -5,3  L 1,7 5,3
C 28  L 0,-21  L -8,-19 8,-19
