# maple_clump_m: a mass of a bigleaf maple's summer leaves.
# A broad dome of leaves, lit from the upper left, its rim scalloped into
# leafy lobes: a forest (12) edge and a moss (13) body, a sage (14) dome
# over its upper left where the light falls, forest shade along its
# underside, a few lit and shaded leaves at the cap's edge. The anchor,
# 0,0, is the middle of its underside. 18 wide, 15 tall.
C 12  L 9,-4 9,-5 8,-6 8,-7 8,-8 8,-9 8,-10 7,-11
      7,-12 6,-12 5,-13 4,-13 3,-13 2,-13 2,-14 1,-15
      0,-15 -1,-15 -2,-15 -3,-14 -3,-13 -4,-13 -5,-12 -6,-12
      -6,-11 -7,-11 -8,-10 -8,-9 -8,-8 -8,-7 -8,-6 -8,-5
      -9,-4 -9,-3 -8,-3 -8,-2 -7,-2 -6,-1 -5,-1 -4,-1
      -3,-1 -2,-1 -1,-1 0,0 1,-1 2,-1 3,-1 4,-1
      5,-1 6,-1 7,-2 8,-2 8,-3 9,-3 10,-3 9,-4
C 13  F 0,-8
C 12  L -9,-4 -5,-3 -2,-5 2,-3 5,-5 9,-6
C 12  F 0,-1
C 14  L 5,-8 5,-9 4,-9 4,-10 3,-11 2,-12 2,-13 1,-13
      0,-13 -1,-13 -2,-13 -3,-12 -4,-12 -5,-12 -6,-12 -7,-11
      -7,-10 -7,-9 -7,-8 -7,-7 -6,-7 -5,-6 -4,-6 -3,-6
      -2,-6 -1,-6 0,-6 1,-6 2,-6 3,-7 4,-7 5,-8
C 14  F -1,-8
C 14  L -6,-9 L 4,-11 L 7,-8
C 13  L -3,-12 L 2,-12
