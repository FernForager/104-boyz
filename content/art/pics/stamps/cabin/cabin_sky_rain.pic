# cabin_sky_rain: the rain's darker deck (BUILD_PLAN S7, 5.8): a heavy slate
# band overhead, slate and glacier blue in lines and checker below it,
# lifting a little toward the valley. The whole sky layer, at the plate's
# origin; its frame runs one pixel outside.
C 9  L -1,-1 160,-1 160,171 -1,171 -1,-1
C 0  L 0,14 159,14  L 0,20 159,20  L 0,34 159,34  L 0,46 159,46  L 0,60 159,60  L 0,70 159,70
C 2  F 80,7
D 2 3 hlines  F 80,17 80,14
D 2 3 checker  F 80,27 80,20
D 3 2 checker  F 80,40 80,34
D 3 2 checker25  F 80,53 80,46
D 3 2 hlines  F 80,65 80,60
C 3  F 80,120 80,70
