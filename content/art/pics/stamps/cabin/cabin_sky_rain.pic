     27,35 30,33 33,32 36,31 39,30 48,30 51,31 54,31
     57,32 60,34 63,39 66,39 69,34 72,33 75,32 78,31
     87,31 90,32 93,33 96,35 99,39 102,35 105,33 108,32
     111,31 114,30 123,30 126,31 129,32 132,33 135,36 138,39
     141,36 144,34 147,33 150,32 160,32
