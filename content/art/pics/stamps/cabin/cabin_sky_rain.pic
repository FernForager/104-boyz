# cabin_sky_rain: the rain's deck (BUILD_PLAN S7, 5.8), a step darker than
# the overcast's throughout: the deck's own flat slate from the very top
# through the name (rows 0 to 28), so the rain never falls out of a blue
# sky; a thin glacier blue rim along its billows where a lower layer's tops
# catch the light; then its slate body down to the valley, with no dark
# underside to smear across the sky (the cloud on the peak carries the
# deck's foot, cabin_rain_cap). The whole sky layer, at the plate's origin;
# its frame runs one pixel outside.
C 9  L -1,-1 160,-1 160,171 -1,171 -1,-1
C 3  L -1,33 0,33 3,32 6,31 15,31 18,32 21,33 24,35
     27,34 30,32 33,31 36,30 39,29 48,29 51,30 54,30
     57,31 60,33 63,38 66,38 69,33 72,32 75,31 78,30
     87,30 90,31 93,32 96,34 99,38 102,34 105,32 108,31
     111,30 114,29 123,29 126,30 129,31 132,32 135,35 138,38
     141,35 144,33 147,32 150,31 160,31
