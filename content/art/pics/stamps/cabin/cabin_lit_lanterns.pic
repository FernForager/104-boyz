# cabin_lit_lanterns: a wall lantern by the door, lit: its glass lamp
# light, a one-pixel halo of warm spill round it. Placed at at_lantern_l,
# and flipped at at_lantern_r. The anchor, 0,0, is the lantern's cap.
C 24  L -1,1 1,1  L -1,2 1,2  L 0,3
C 28  L -2,1 -2,3  L 2,3  L -1,4  L 1,4  L 0,5  L -2,0  L 2,0
