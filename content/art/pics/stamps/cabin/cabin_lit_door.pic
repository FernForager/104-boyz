# cabin_lit_door: the screen door at night, lit from inside: its screen one
# flat field of lamp light (the mid rail and the kick panel stay the
# frame's), its knob ink against it; the deck before it in the checker the
# banks' spill uses; each step's tread lit along its front lip in a checker
# that widens as they come down; and a sparse fan of light on the grass
# before the steps, a checker25 that widens from their foot and thins at
# its far edge. The anchor, 0,0, is at_door, the door's top left corner.
C 24  L 2,2 12,2 12,15 2,15 2,2  F 3,3
      L 2,20 12,20 12,23 2,23 2,20  F 3,21
      L 2,18 12,18  L 2,19 10,19  L 12,19
C 0  L 11,19
C 28  L -3,32  L -1,32  L 1,32  L 3,32  L 5,32  L 7,32
      L 9,32  L 11,32  L 13,32  L 15,32  L 17,32  L 0,33
      L 4,33  L 8,33  L 12,33  L 16,33  L 1,34  L 3,34
      L 5,34  L 7,34  L 9,34  L 11,34  L 13,34  L -1,39
      L 1,39  L 3,39  L 5,39  L 7,39  L 9,39  L 11,39
      L 13,39  L 15,39  L -3,44  L -1,44  L 1,44  L 3,44
      L 5,44  L 7,44  L 9,44  L 11,44  L 13,44  L 15,44
      L 17,44  L -5,49  L -3,49  L -1,49  L 1,49  L 3,49
      L 5,49  L 7,49  L 9,49  L 11,49  L 13,49  L 15,49
      L 17,49  L 19,49  L -7,56  L -5,56  L -3,56  L -1,56
      L 1,56  L 3,56  L 5,56  L 7,56  L 9,56  L 11,56
      L 13,56  L 15,56  L 17,56  L 19,56  L 21,56  L -10,58
      L -6,58  L -2,58  L 2,58  L 6,58  L 10,58  L 14,58
      L 18,58  L 22,58  L -13,61  L -9,61  L -5,61  L -1,61
