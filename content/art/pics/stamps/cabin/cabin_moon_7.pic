# cabin_moon_7: the moon at a waning crescent (7 eighths of its month), lit on the left while waning
# (lead call 54). Plain lamp light (24), so it stays bright at night, with
# no mark inside it (at phone size a mark reads as a face). Its lit part is one continuous arc, two pixels thick at its middle, its horns one pixel, hugging the limb.
# Drawn for the phone's wide pixels: 6 columns by 10 rows, rounded, so it
# reads round. The anchor, 0,0, is at_moon, just right of and below the
# disc's middle.
C 24  L -1,-5  L -2,-4  L -3,-3  L -3,-2 -2,-2  L -3,-1 -2,-1  L -3,0 -2,0
      L -3,1 -2,1  L -3,2  L -2,3  L -1,4
