# cabin_sky_cloudy: a low overcast over the cabin (BUILD_PLAN S7, 5.8): snow
# and glacier blue mottled in checker seams, slate bands low where the
# cloud's underside drags over the valley; lighter than the rain's. The
# whole sky layer, at the plate's origin; its frame runs one pixel outside.
C 9  L -1,-1 160,-1 160,171 -1,171 -1,-1
C 0  L 0,6 159,6  L 0,12 159,12  L 0,28 159,28  L 0,36 159,36  L 0,50 159,50  L 0,58 159,58  L 0,64 159,64  L 0,70 159,70  L 0,74 159,74
D 3 4 checker  F 80,3
D 4 3 checker25  F 80,9 80,6
C 4  F 80,20 80,12
D 4 3 checker25  F 80,32 80,28
D 4 3 checker  F 80,43 80,36
D 3 4 checker25  F 80,54 80,50
C 3  F 80,61 80,58
D 3 2 checker25  F 80,67 80,64
D 2 3 hlines  F 80,72 80,70
C 3  F 80,122 80,74
