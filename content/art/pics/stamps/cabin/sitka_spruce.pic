# sitka_spruce: the towering Sitka spruce behind the cabin's roof
# (GAME_DESIGN 11.11: stacked tiers with drooping tips, taller than
# everything). Lit from the upper left: each tier's left half forest (12),
# its right half spruce (11) in shade; each tier's outer tips hang lowest,
# the way a Sitka's branches droop. Drawn top tier first, so each tier
# hangs over the one below. The anchor, 0,0, is the foot of the trunk
# (hidden by the roof). 37 wide, 124 tall, 11 tiers.
C 12  L 0,-124 0,-122
# tier 11
C 12  L 0,-122 -2,-110 0,-110 0,-122
C 11  L 1,-122 3,-110 1,-110 1,-122
C 12  L -2,-109 -2,-108  L -1,-109
C 11  L 3,-109 3,-108  L 2,-109
# tier 10
C 12  L 0,-116 -4,-102 0,-102 0,-116
F -1,-103
C 11  L 1,-116 5,-102 1,-102 1,-116
F 2,-103
C 12  L -4,-101 -4,-100  L -3,-101
C 11  L 5,-101 5,-100  L 4,-101
# tier 9
