# maple_clump_s: a small clump of a bigleaf maple's summer leaves.
# A lobed dome of leaves, lit from the upper left: a forest (12) edge and
# moss (13) leaves, a sage (14) cap where the light falls, forest shade
# along its underside, a few lit leaves. The anchor, 0,0, is the middle of
# its underside. 12 wide, 9 tall.
C 12  L 7,-4 6,-5 5,-6 5,-7 5,-8 4,-8 3,-8 2,-8
      1,-9 0,-9 -1,-10 -2,-9 -3,-8 -5,-8 -6,-7 -6,-6
      -5,-5 -6,-4 -6,-3 -6,-2 -4,-2 -3,-2 -3,-1 -2,-1
      -1,-1 0,-1 1,-1 2,-1 3,-1 4,-1 4,-2 4,-3
      5,-3 7,-4
C 13  F 0,-4
C 12  L -5,-2 -3,-2 -1,-2 1,-1 3,-2 5,-3
C 12  F 0,-2
C 14  L 2,-6 1,-6 1,-7 0,-7 0,-8 -1,-8 -2,-7 -3,-7
      -4,-7 -4,-6 -4,-5 -5,-5 -4,-4 -3,-5 -2,-4 -1,-4
      0,-4 0,-5 1,-5 2,-5 2,-6
C 14  F -2,-6
C 14  L -4,-5 L 3,-6
C 13  L 1,-2
