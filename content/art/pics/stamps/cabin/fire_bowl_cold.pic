# fire_bowl_cold: the big iron fire bowl on the lawn (GAME_DESIGN 2.2,
# 11.11), cold: a wide cone of dark rusted iron (brick) on a small foot,
# seen a little from above: its rim an ellipse lit rust on the left, the
# dark inside (bark, ink under the far rim) with slate ash in its bottom,
# the cone shaded bark on its right, an ink shadow under its foot and moss
# where its shadow falls on the grass. The anchor, 0,0, is under the
# foot's middle. 25 wide, 17 tall.
# the rim and the mouth
C 9  L -12,-13 -11,-14 -9,-15 -6,-16 6,-16 9,-15 11,-14 12,-13
      11,-12 9,-11 6,-10 -6,-10 -9,-11 -11,-12 -12,-13
C 10  F 0,-13
C 8  L -12,-13 -11,-14 -9,-15 -6,-16 -1,-16  L -11,-12 -9,-11 -6,-10 -2,-10
C 0  L -9,-14 -6,-15  L -5,-15 5,-15  L 6,-15 9,-14
C 2  L -6,-12 6,-12  L -4,-13 4,-13  L -5,-11 5,-11
# the cone, tapering to its foot, its right third in shade
C 9  L -12,-12 -4,-2 4,-2 12,-12
C 9  F 0,-6
C 8  L -11,-11 -5,-4  L -10,-11 -9,-10
C 10  L 6,-9 3,-3  L 7,-9 4,-3  L 8,-9 4,-2  L 9,-10 5,-3  L 10,-10 6,-4  L 11,-11 7,-5
# the foot, its shadow, and the shadow on the grass
C 10  L -4,-1 4,-1
C 0  L -6,0 8,0
C 13  L -2,1 11,1  L 9,0 13,0
