# fire_bowl_cold: the big iron fire bowl on the lawn (GAME_DESIGN 2.2,
# 11.11), cold: a wide rust (8) cone on a small foot, seen a little from
# above: its rim an ellipse, the dark brick (9) inside with slate (2) ash in
# its bottom, brick on the cone's shaded right, a glint on its lit left
# rim, an ink shadow on the grass. The anchor, 0,0, is under the foot's
# middle. 25 wide, 17 tall.
# the rim and the mouth
C 8  L -12,-13 -11,-14 -9,-15 -6,-16 6,-16 9,-15 11,-14 12,-13
      11,-12 9,-11 6,-10 -6,-10 -9,-11 -11,-12 -12,-13
C 9  F 0,-13
C 2  L -6,-12 6,-12  L -4,-13 4,-13  L -7,-11 7,-11
C 0  L -9,-14 -6,-15  L -5,-15 5,-15  L 6,-15 9,-14
# the cone, tapering to its foot
C 8  L -12,-12 -4,-2 4,-2 12,-12
C 8  F 0,-6
C 9  L 6,-9 3,-3  L 7,-9 4,-3  L 8,-9 4,-2  L 9,-10 5,-3  L 10,-10 6,-4  L 11,-11 7,-5
C 6  L -10,-14 -8,-15  L -11,-12 -8,-9
# the foot and the shadow
C 10  L -4,-1 4,-1
C 0  L -9,0 9,0  L -6,1 6,1
