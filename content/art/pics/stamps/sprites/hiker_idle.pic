# hiker_idle: the hiker, standing (GAME_DESIGN 11.6, 12.4; BUILD_PLAN S5
# brief B6). Every hiker the same: a rust (8) jacket and cap with a brim,
# a paper-cream (5) face with one ink (0) eye, the brick (9) mid pack on the
# back, slate (2) legs (jeans or hiking pants read the same at this size),
# ink (0) boots. Faces right; the composer flips it to face left. The anchor,
# 0,0, is under the feet, at their center. 7 wide, 18 tall. No dither, and no
# gear the player didn't pack (the pack's other sizes, the pad roll and the
# pot come with the flat lay, S12a).
C 8  L -1,-17 1,-17  L -1,-16 2,-16  L -1,-13 1,-13  L -1,-12 2,-12
      L -1,-11 2,-11  L -1,-10 2,-10  L -1,-9 2,-9  L -1,-8 2,-8
      L -1,-7 1,-7
C 5  L -1,-15 0,-15  L -1,-14 1,-14  L 2,-7
C 0  L 1,-15  L -1,-1 -1,0  L 1,-1  L 1,0 2,0
C 9  L -3,-14 -2,-14  L -3,-13 -2,-13  L -3,-12 -2,-12  L -3,-11 -2,-11
      L -3,-10 -2,-10  L -3,-9 -2,-9  L -3,-8 -2,-8  L -3,-7 -2,-7
C 2  L -1,-6 -1,-2  L 1,-6 1,-2
# The Look hotspot (S6): the hiker, cap to boots and pack, in the stamp's
# coordinates; a flipped hiker's flips with it.
Z hiker -3,-17,6,18
