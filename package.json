{
  "name": "olympic-peninsula-hiker",
  "version": "0.1.0",
  "private": true,
  "description": "Olympic Peninsula Hiker (OP Hiker): a backpacking adventure on the Olympic Peninsula, in the style of the old Sierra adventures.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "ingest": "node tools/ingest.mjs",
    "lint": "node tools/lint.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "render": "node tools/render-pics.mjs",
    "listen": "node tools/listen.mjs",
    "shots": "node tools/shots.mjs",
    "serve": "node tools/serve.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "sim:smoke": "node tools/sim.mjs --smoke 1000",
    "play": "node tools/play.mjs",
    "ci": "npm run build && npm run lint && npm run typecheck && npm run test && npm run sim:smoke",
    "text:check": "node tools/text.mjs check",
    "text:count": "node tools/text.mjs count",
    "text:apply": "node tools/text.mjs apply",
    "text:batch": "node tools/text.mjs batch"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
