{
 "$comment": "content/rules/profile.json: the Open hiker's profile rules (GAME_DESIGN 7.3, 7.10, 12.4; E.1). Rules-hashed.",
 "type": "object",
 "required": ["fitness_levels", "skills", "name_max", "open_start"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "fitness_levels": { "type": "array", "items": { "$ref": "#/$defs/id" } },
  "skills": { "type": "array", "items": { "$ref": "#/$defs/id" } },
  "name_max": { "type": "integer", "minimum": 1, "maximum": 40 },
  "open_start": { "$ref": "#/$defs/profile" }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "profile": {
   "$comment": "The profile snapshot's fields (E.1): exactly what the engine reads.",
   "type": "object",
   "required": ["fitness", "body_lb", "skills", "regions", "seen"],
   "additionalProperties": false,
   "properties": {
    "fitness": { "$ref": "#/$defs/id" },
    "body_lb": { "type": "integer", "minimum": 60, "maximum": 400 },
    "skills": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 5 } },
    "regions": { "type": "object" },
    "seen": { "type": "object" }
   }
  }
 }
}
