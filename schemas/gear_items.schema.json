{
 "$comment": "content/gear/items.json: the gear catalog as the game reads it, generated by tools/ingest.mjs (tools/ingest/catalogs.mjs; BUILD_PLAN 2.6, 11.3, S4; GAME_DESIGN 5.7, 5.8, 6.1). Never hand-edited. No names or notes: words stay in design/data until a screen's session drafts them. origin lists the counters whose shelves carry each version (general, gear, desk); look is a palette pair and a dither; basic is free, nice costs price_usd.",
 "type": "object",
 "required": ["format", "packs", "items"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "packs": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["volume_l", "weight_oz", "comfortable_max_load_lb", "price_usd", "basic", "frame", "hipbelt", "outside_slots", "rain_resistance", "tags", "origin", "look"],
    "additionalProperties": false,
    "properties": {
     "volume_l": { "type": "number", "minimum": 0 },
     "weight_oz": { "type": "number", "minimum": 0 },
     "comfortable_max_load_lb": { "type": "number", "minimum": 0 },
     "price_usd": { "type": "number", "minimum": 0 },
     "basic": { "type": "boolean" },
     "frame": { "$ref": "#/$defs/id" },
     "hipbelt": { "$ref": "#/$defs/id" },
     "outside_slots": { "type": "object", "additionalProperties": { "type": "number" } },
     "rain_resistance": { "type": "number" },
     "tags": { "$ref": "#/$defs/ids" },
     "origin": { "$ref": "#/$defs/origin" },
     "look": { "$ref": "#/$defs/look" }
    }
   }
  },
  "items": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["category", "weight_oz", "volume_l", "carry", "price_usd", "basic", "ten_essentials", "tags", "stats", "origin", "look"],
    "additionalProperties": false,
    "properties": {
     "category": { "$ref": "#/$defs/id" },
     "weight_oz": { "type": "number", "minimum": 0 },
     "volume_l": { "type": "number", "minimum": 0 },
     "carry": { "enum": ["inside", "outside_strappable", "worn"] },
     "price_usd": { "type": "number", "minimum": 0 },
     "basic": { "type": "boolean" },
     "ten_essentials": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
     "tags": { "$ref": "#/$defs/ids" },
     "stats": { "type": "object" },
     "tiers": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": ["weight_oz", "volume_l", "price_usd", "basic", "origin"],
       "additionalProperties": false,
       "properties": {
        "weight_oz": { "type": "number", "minimum": 0 },
        "volume_l": { "type": "number", "minimum": 0 },
        "price_usd": { "type": "number", "minimum": 0 },
        "basic": { "type": "boolean" },
        "stats": { "type": "object" },
        "tags_add": { "$ref": "#/$defs/ids" },
        "tags_remove": { "$ref": "#/$defs/ids" },
        "origin": { "$ref": "#/$defs/origin" }
       }
      }
     },
     "origin": { "$ref": "#/$defs/origin" },
     "look": { "$ref": "#/$defs/look" },
     "estimate": { "const": true }
    }
   }
  }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
  "origin": { "type": "array", "items": { "enum": ["general", "gear", "desk"] } },
  "look": {
   "type": "object",
   "required": ["pair", "dither"],
   "additionalProperties": false,
   "properties": {
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 15 } },
    "dither": { "enum": ["flat", "brick", "diag", "hlines", "checker"] }
   }
  }
 }
}
