{
 "$comment": "content/park/conditions/*.json: the dated conditions overlay, generated by tools/ingest.mjs (tools/ingest/conditions.mjs; BUILD_PLAN 2.6, S4; GAME_DESIGN 4.6, 4.7, E.4). Never hand-edited. conditions_date is the overlay's research date, never a clock. Each entry has until or persists; structured: false marks a region's news kept inert until its milestone. No English: the research's notes stay in design/data.",
 "type": "object",
 "required": ["format", "conditions_date", "entries"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "conditions_date": { "$ref": "#/$defs/date" },
  "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(->[a-z][a-z0-9_]*)?$" },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "entry": {
   "type": "object",
   "required": ["id", "region", "from", "last_confirmed", "applies_to", "effect", "source", "confidence", "structured"],
   "additionalProperties": false,
   "properties": {
    "id": { "$ref": "#/$defs/id" },
    "region": { "$ref": "#/$defs/id" },
    "from": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "until": { "$ref": "#/$defs/date" },
    "persists": { "const": true },
    "windows": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/date" } } },
    "hours": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 24 } } },
    "last_confirmed": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "stale_after": { "$ref": "#/$defs/date" },
    "stale": { "const": true },
    "applies_to": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "effect": { "enum": ["open", "fire_ban", "road_closure", "road_walk", "single_lane", "full_snapshot", "hazard", "blowdown", "snow_year", "news", "staffing", "history", "superseded", "closure", "maybe_closed"] },
    "extra_mi10": { "type": "integer", "minimum": 1 },
    "estimate": { "const": true },
    "adds_hazards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "hazard_card": {
     "type": "object",
     "required": ["id", "where", "mitigations"],
     "additionalProperties": false,
     "properties": { "id": { "$ref": "#/$defs/id" }, "where": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "mitigations": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    },
    "source": { "oneOf": [{ "type": "string", "pattern": "^https?://" }, { "type": "null" }] },
    "confidence": { "enum": ["high", "medium", "low", null] },
    "structured": { "type": "boolean" },
    "derived_from": { "const": "hazard" }
   }
  }
 }
}
