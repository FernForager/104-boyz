{
 "$comment": "content/data/climate.json: the climate table, generated by tools/ingest.mjs (tools/ingest/climate.mjs; BUILD_PLAN 2.6, S4; GAME_DESIGN 7.5, E.5) from park_rules.json climate. Never hand-edited. Months are \"1\" to \"12\"; every number is the source's; each block keeps its computed or estimate flag and its source URLs.",
 "type": "object",
 "required": ["format", "chain", "zones", "high_overlays", "freezing_level_ft", "snow_free", "cabin", "sources"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "chain": {
   "type": "object",
   "required": ["states", "months", "station", "period", "computed", "estimate_rows", "sources"],
   "additionalProperties": false,
   "properties": {
    "states": { "const": ["fair", "unsettled", "wet", "storm"] },
    "months": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": ["p", "next"],
      "additionalProperties": false,
      "properties": {
       "p": { "$ref": "#/$defs/four" },
       "next": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/four" } }
      }
     }
    },
    "station": { "$ref": "#/$defs/id" },
    "period": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
    "computed": { "type": "boolean" },
    "estimate_rows": { "$ref": "#/$defs/cells" },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "zones": {
   "type": "object",
   "required": ["coast", "west_valleys", "north_mid", "high", "east_high", "alpine"],
   "additionalProperties": false,
   "properties": {
    "coast": { "$ref": "#/$defs/zone" },
    "west_valleys": { "$ref": "#/$defs/zone" },
    "north_mid": { "$ref": "#/$defs/zone" },
    "high": { "$ref": "#/$defs/zone" },
    "east_high": { "$ref": "#/$defs/zone" },
    "alpine": {
     "type": "object",
     "required": ["from_station", "lapse_f_per_1000ft", "estimate", "confidence", "sources"],
     "additionalProperties": false,
     "properties": {
      "from_station": { "$ref": "#/$defs/id" },
      "lapse_f_per_1000ft": { "type": "number", "minimum": 0 },
      "estimate": { "const": true },
      "confidence": { "$ref": "#/$defs/confidence" },
      "sources": { "$ref": "#/$defs/urls" }
     }
    }
   }
  },
  "high_overlays": {
   "type": "object",
   "required": ["thunder", "fog", "wind", "wet_given_state"],
   "additionalProperties": false,
   "properties": {
    "thunder": { "$ref": "#/$defs/overlay" },
    "fog": { "$ref": "#/$defs/overlay" },
    "wind": { "$ref": "#/$defs/overlay" },
    "wet_given_state": { "$ref": "#/$defs/overlay" }
   }
  },
  "freezing_level_ft": {
   "type": "object",
   "required": ["months", "computed", "confidence", "sources"],
   "additionalProperties": false,
   "properties": { "months": { "$ref": "#/$defs/months" }, "computed": { "const": true }, "confidence": { "$ref": "#/$defs/confidence" }, "sources": { "$ref": "#/$defs/urls" } }
  },
  "snow_free": {
   "type": "object",
   "additionalProperties": true,
   "properties": { "computed": { "const": true }, "sources": { "$ref": "#/$defs/urls" } }
  },
  "cabin": { "type": "object", "required": ["zone"], "additionalProperties": false, "properties": { "zone": { "const": "west_valleys" } } },
  "sources": { "$ref": "#/$defs/urls" }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "four": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
  "cells": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } },
  "urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
  "confidence": { "enum": ["high", "medium", "low"] },
  "months": { "type": "object", "additionalProperties": { "type": "object" } },
  "zone": {
   "type": "object",
   "required": ["stations", "sources"],
   "properties": {
    "stations": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": ["elev_ft", "months"],
      "additionalProperties": false,
      "properties": { "elev_ft": { "type": "integer" }, "elev_est": { "const": true }, "months": { "$ref": "#/$defs/months" } }
     }
    },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "overlay": {
   "type": "object",
   "required": ["months", "sources"],
   "properties": { "months": { "type": "object" }, "sources": { "$ref": "#/$defs/urls" } }
  }
 }
}
