{
 "$comment": "content/data/quinault_sun.json and content/data/daylight.json: the sun tables, generated by tools/ingest.mjs (tools/sun.mjs; BUILD_PLAN 3.5, S4; GAME_DESIGN 2.2, 7.2, E.5; Lead call 34). Never hand-edited. One row per day from `from` through `to`: [utc_offset_h, civil_dawn_s, sunrise_s, sunset_s, civil_dusk_s], seconds since local midnight, Pacific time by the US rule since 2007.",
 "type": "object",
 "required": ["format", "point", "point_from", "source", "method", "zenith_milli", "tz", "from", "to", "days"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
  "point_from": { "type": "string", "pattern": "^content/" },
  "source": { "type": "string", "pattern": "^https://" },
  "method": { "const": "noaa_zenith_floor_1" },
  "zenith_milli": {
   "type": "object",
   "required": ["rise_set", "civil"],
   "additionalProperties": false,
   "properties": { "rise_set": { "const": 90833 }, "civil": { "const": 96000 } }
  },
  "tz": { "const": "us_pacific_2007" },
  "from": { "$ref": "#/$defs/date" },
  "to": { "$ref": "#/$defs/date" },
  "days": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5,
    "items": { "type": "integer", "minimum": -8, "maximum": 86400 }
   }
  }
 },
 "$defs": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
}
