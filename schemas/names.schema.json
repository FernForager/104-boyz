{
 "$comment": "content/text/names/*.json: the gazetteer (places.json, generated by ingest from the park's nodes; places_extra.json, by hand) and the terms (terms.json, by hand) (GAME_DESIGN 18.2; BUILD_PLAN 3.2, 10.2, 10.5, S4). Not ours: no approval, still vetoable (a cut verdict on place.<id> or term.<id>). tools/text.mjs reads and validates them; lint T16 checks every place a screen shows against them.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "places": { "type": "object", "additionalProperties": { "$ref": "#/$defs/place" } },
  "not_places": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["text", "why"],
    "additionalProperties": false,
    "properties": { "text": { "$ref": "#/$defs/words" }, "why": { "enum": ["descriptive", "no_source"] }, "region": { "$ref": "#/$defs/id" } }
   }
  },
  "terms": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["text", "kind", "source"],
    "additionalProperties": false,
    "properties": { "text": { "$ref": "#/$defs/words" }, "kind": { "enum": ["species", "nws", "term"] }, "source": { "$ref": "#/$defs/url" } }
   }
  }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "url": { "type": "string", "pattern": "^https?://\\S+$" },
  "words": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
  "place": {
   "type": "object",
   "required": ["text", "kind", "source"],
   "additionalProperties": false,
   "properties": {
    "text": { "$ref": "#/$defs/words" },
    "kind": { "$ref": "#/$defs/id" },
    "region": { "$ref": "#/$defs/id" },
    "source": { "$ref": "#/$defs/url" },
    "unofficial": { "const": true },
    "forms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/words" } }
   }
  }
 }
}
