{
 "$comment": "content/park/regions/*.json: a normalized region, generated by tools/ingest.mjs (BUILD_PLAN 3.2, S4; GAME_DESIGN E.4). Never hand-edited. Distances in tenths of a mile (mi10), elevations in whole feet, no English: names live in the gazetteer (content/text/names/).",
 "type": "object",
 "required": ["format", "region", "researched_on", "nodes", "segments", "trailheads", "presets", "hazards", "crossings", "traffic", "sources"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "region": { "$ref": "#/$defs/id" },
  "researched_on": { "$ref": "#/$defs/date" },
  "nodes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/node" } },
  "segments": { "type": "object", "additionalProperties": { "$ref": "#/$defs/segment" } },
  "trailheads": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["drive_min", "drive_est"],
    "additionalProperties": false,
    "properties": {
     "drive_min": { "type": "object", "additionalProperties": { "type": ["integer", "null"], "minimum": 0 } },
     "drive_est": { "type": "boolean" }
    }
   }
  },
  "presets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/preset" } },
  "hazards": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["where", "tags", "mitigations"],
    "additionalProperties": false,
    "properties": {
     "where": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
     "tags": { "$ref": "#/$defs/ids" },
     "mitigations": { "$ref": "#/$defs/ids" }
    }
   }
  },
  "crossings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["at", "segment", "kind"],
    "additionalProperties": false,
    "properties": { "at": { "$ref": "#/$defs/id" }, "segment": { "$ref": "#/$defs/seg_id" }, "kind": { "$ref": "#/$defs/id" } }
   }
  },
  "traffic": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "hour_factor": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "month_factor": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "weather_factor": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "sections": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": ["segments", "parties_per_hour", "rangers_per_hour"],
      "additionalProperties": false,
      "properties": {
       "segments": { "type": "array", "items": { "$ref": "#/$defs/seg_id" } },
       "parties_per_hour": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
       "rangers_per_hour": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
     }
    },
    "estimate": { "type": "boolean" }
   }
  },
  "sources": { "$ref": "#/$defs/urls" }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
  "seg_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*->[a-z][a-z0-9_]*$" },
  "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(->[a-z][a-z0-9_]*)?$" },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://\\S+$" } },
  "node": {
   "type": "object",
   "required": ["type", "elev_ft", "elev_est", "lat", "lon", "zone", "camp", "spur_only", "shared_with", "sources"],
   "additionalProperties": false,
   "properties": {
    "type": { "$ref": "#/$defs/id" },
    "elev_ft": { "type": ["integer", "null"] },
    "elev_est": { "type": "boolean" },
    "lat": { "type": ["number", "null"], "minimum": 46, "maximum": 49 },
    "lon": { "type": ["number", "null"], "minimum": -125, "maximum": -122 },
    "zone": { "oneOf": [{ "type": "null" }, { "enum": ["coast", "west_valleys", "north_mid", "high", "east_high", "alpine"] }] },
    "camp": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/camp" }] },
    "spur_only": { "type": "boolean" },
    "place": { "$ref": "#/$defs/place" },
    "shared_with": { "$ref": "#/$defs/ids" },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "camp": {
   "type": "object",
   "required": ["sites", "group_site", "stock_site", "group_sites", "stock_sites", "desk", "bear_can", "food_storage", "fires", "toilet"],
   "additionalProperties": false,
   "properties": {
    "sites": { "type": ["integer", "null"], "minimum": 0 },
    "sites_est": { "const": true },
    "group_site": { "type": "boolean" },
    "stock_site": { "type": "boolean" },
    "group_sites": { "type": "integer", "minimum": 0 },
    "stock_sites": { "type": "integer", "minimum": 0 },
    "desk": { "type": "boolean" },
    "bear_can": { "type": ["boolean", "null"] },
    "food_storage": { "oneOf": [{ "type": "null" }, { "enum": ["can", "locker", "none", "unknown"] }] },
    "fires": { "type": ["boolean", "null"] },
    "toilet": { "type": ["boolean", "null"] }
   }
  },
  "place": {
   "$comment": "GAME_DESIGN E.5's overlay fields per place, from the research's m1a_play_inputs.places (flagged estimates): water and the other month-keyed fields by month number.",
   "type": "object",
   "required": ["map_xy", "canopy", "cold_pool", "water", "views", "view_score", "traffic", "lily"],
   "additionalProperties": false,
   "properties": {
    "map_xy": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } }] },
    "canopy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "cold_pool": { "type": ["boolean", "null"] },
    "water": { "type": "object", "additionalProperties": { "enum": ["sure", "likely", "unverified", "near", "river", "none"] } },
    "views": { "$ref": "#/$defs/ids" },
    "view_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "traffic": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "lily": {
     "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["m1a", "from_m1b"], "additionalProperties": false, "properties": { "m1a": { "type": "number", "minimum": 0 }, "from_m1b": { "type": "number", "minimum": 0 } } }
     ]
    },
    "snow_feature": {
     "type": "object",
     "required": ["normal_window", "low_shift_days", "high_shift_days", "estimate"],
     "additionalProperties": false,
     "properties": {
      "normal_window": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" } },
      "low_shift_days": { "type": ["integer", "null"] },
      "high_shift_days": { "oneOf": [{ "type": "null" }, { "type": "integer" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } }] },
      "estimate": { "type": "boolean" }
     }
    }
   }
  },
  "segment": {
   "type": "object",
   "required": ["a", "b", "mi10", "gain", "loss", "est", "class", "through", "spur", "one_way", "no_camping", "hazards", "snow_free_doy", "sources"],
   "additionalProperties": false,
   "properties": {
    "a": { "$ref": "#/$defs/id" },
    "b": { "$ref": "#/$defs/id" },
    "mi10": { "type": ["integer", "null"], "minimum": 0 },
    "gain": { "type": ["integer", "null"], "minimum": 0 },
    "loss": { "type": ["integer", "null"], "minimum": 0 },
    "est": { "type": "array", "items": { "enum": ["class", "gain", "loss", "mi10"] } },
    "class": { "enum": ["road_walk", "maintained", "primitive", "way_trail", "off_trail", "snow", "beach_sand", "beach_cobble", "coast_overland"] },
    "through": { "type": "boolean" },
    "spur": {
     "oneOf": [
      { "type": "null" },
      {
       "type": "object",
       "required": ["summit", "junction", "out_and_back", "preferred"],
       "additionalProperties": false,
       "properties": { "summit": { "$ref": "#/$defs/id" }, "junction": { "$ref": "#/$defs/id" }, "out_and_back": { "type": "boolean" }, "preferred": { "type": "boolean" } }
      }
     ]
    },
    "one_way": { "type": "boolean" },
    "no_camping": { "type": "boolean" },
    "hazards": { "type": "array", "items": { "type": "string", "pattern": "^(x_)?[a-z][a-z0-9_]*$" } },
    "snow_free_doy": {
     "oneOf": [
      { "type": "null" },
      { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1, "maximum": 366 } } }
     ]
    },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "preset": {
   "type": "object",
   "required": ["trailhead", "shape", "nights", "difficulty", "days", "mi10", "typed_mi10"],
   "additionalProperties": false,
   "properties": {
    "trailhead": { "$ref": "#/$defs/id" },
    "shape": { "$ref": "#/$defs/id" },
    "nights": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }] },
    "difficulty": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "days": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["to", "via", "mi10", "typed_mi10"],
      "additionalProperties": false,
      "properties": {
       "to": { "$ref": "#/$defs/id" },
       "via": { "$ref": "#/$defs/ids" },
       "mi10": { "type": "integer", "minimum": 0 },
       "typed_mi10": { "type": ["integer", "null"], "minimum": 0 }
      }
     }
    },
    "mi10": { "type": "integer", "minimum": 0 },
    "typed_mi10": { "type": ["integer", "null"], "minimum": 0 }
   }
  }
 }
}
