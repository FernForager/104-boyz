{
 "$comment": "content/rules/kits.json: the ranger's checklist and sensible kit, the two pack presets and the test kits (BUILD_PLAN 2.6, 3.5, S4; GAME_DESIGN 6.1, 3.6, 5.8, B.5). Hand-authored; tools/ingest/catalogs.mjs checks every id and tier against the catalog and runs the basics guarantee (IG16) over the needs.",
 "type": "object",
 "required": ["checklist", "ranger", "presets", "test_kits"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "checklist": {
   "type": "object",
   "required": ["rows", "needs", "worn", "canister", "fuels", "not_traps"],
   "additionalProperties": false,
   "properties": {
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "needs": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/need" } } },
    "worn": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/need" } },
    "canister": { "$ref": "#/$defs/need" },
    "fuels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } },
    "not_traps": { "type": "boolean" }
   }
  },
  "ranger": {
   "type": "object",
   "required": ["doc"],
   "properties": { "doc": { "type": "string", "minLength": 1 } },
   "additionalProperties": { "type": "object", "additionalProperties": { "const": "checklist" } }
  },
  "presets": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["doc"],
    "additionalProperties": false,
    "properties": {
     "pack": { "$ref": "#/$defs/item" },
     "worn": { "$ref": "#/$defs/items" },
     "carried": { "$ref": "#/$defs/items" },
     "food": {
      "type": "object",
      "required": ["kcal_per_day", "distinct_dinners"],
      "additionalProperties": false,
      "properties": { "kcal_per_day": { "type": "integer", "minimum": 1 }, "distinct_dinners": { "type": "boolean" } }
     },
     "from_kit": { "$ref": "#/$defs/kit" },
     "from": { "$ref": "#/$defs/id" },
     "minus": { "$ref": "#/$defs/items" },
     "doc": { "type": "string", "minLength": 1 }
    }
   }
  },
  "test_kits": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["pack", "nights", "worn", "carried"],
    "additionalProperties": false,
    "properties": { "pack": { "$ref": "#/$defs/item" }, "nights": { "type": "integer", "minimum": 0 }, "worn": { "$ref": "#/$defs/items" }, "carried": { "$ref": "#/$defs/items" } }
   }
  }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "kit": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(_TRAP[a-z0-9_]*)?$" },
  "item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(:(cheap|standard|premium))?$" },
  "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
  "tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
  "need": {
   "type": "object",
   "required": ["id"],
   "additionalProperties": false,
   "properties": {
    "id": { "$ref": "#/$defs/id" },
    "trip": { "enum": ["day", "overnight"] },
    "months": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
    "any_tags": { "$ref": "#/$defs/tags" },
    "all_tags": { "$ref": "#/$defs/tags" },
    "not_tags": { "$ref": "#/$defs/tags" },
    "ten": { "$ref": "#/$defs/id" },
    "covers": { "$ref": "#/$defs/id" },
    "fuel_for": { "$ref": "#/$defs/id" }
   }
  }
 }
}
