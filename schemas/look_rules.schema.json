{
 "$comment": "content/gear/look_rules.json: how each gear item looks in the flat lay before S12a's stamps (GAME_DESIGN 6.1, 11.1; BUILD_PLAN 11.3). Pairs are two palette slots, light then dark; never a slot in never_slots.",
 "type": "object",
 "required": ["by_category", "by_id", "dither_by_id", "dither_by_tag", "dithers", "never_slots"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "by_category": { "type": "object", "additionalProperties": { "$ref": "#/$defs/pair" } },
  "by_id": { "type": "object", "additionalProperties": { "$ref": "#/$defs/pair" } },
  "dither_by_id": { "type": "object", "additionalProperties": { "$ref": "#/$defs/dither" } },
  "dither_by_tag": { "type": "object", "additionalProperties": { "$ref": "#/$defs/dither" } },
  "dithers": { "type": "array", "items": { "$ref": "#/$defs/dither" } },
  "never_slots": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 15 } }
 },
 "$defs": {
  "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 15 } },
  "dither": { "enum": ["flat", "brick", "diag", "hlines", "checker"] }
 }
}
