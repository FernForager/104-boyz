{
 "$comment": "content/park/permits.json: the permit rules, generated by tools/ingest.mjs (tools/ingest/permits.mjs; BUILD_PLAN 2.6, S4; GAME_DESIGN 3.1, 4.3, 4.6, 5.8) from park_rules.json permits and the Sol Duc region's m1a_play_inputs. Never hand-edited. Month-days are \"MM-DD\", months 1-12, nights fri to thu.",
 "type": "object",
 "required": ["format", "season", "fees", "group", "quota_areas", "quota", "desk", "rangers", "visitors", "loaner", "sources"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "season": {
   "type": "object",
   "required": ["summer", "winter", "sources"],
   "additionalProperties": false,
   "properties": { "summer": { "$ref": "#/$defs/mdRange" }, "winter": { "$ref": "#/$defs/mdRange" }, "sources": { "$ref": "#/$defs/urls" } }
  },
  "fees": {
   "type": "object",
   "required": ["per_adult_per_night_usd", "per_permit_usd", "youth_15_and_under_usd", "shown_not_paid", "sources"],
   "additionalProperties": false,
   "properties": {
    "per_adult_per_night_usd": { "type": "integer", "minimum": 0 },
    "per_permit_usd": { "type": "integer", "minimum": 0 },
    "youth_15_and_under_usd": { "type": "integer", "minimum": 0 },
    "shown_not_paid": { "const": true },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "group": {
   "type": "object",
   "required": ["max", "group_site_from", "sources"],
   "additionalProperties": false,
   "properties": { "max": { "type": "integer", "minimum": 1 }, "group_site_from": { "type": "integer", "minimum": 1 }, "sources": { "$ref": "#/$defs/urls" } }
  },
  "quota_areas": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["camps", "online", "structured"],
    "additionalProperties": false,
    "properties": { "camps": { "$ref": "#/$defs/ids" }, "online": { "oneOf": [{ "$ref": "#/$defs/mdRange" }, { "type": "null" }] }, "structured": { "type": "boolean" } }
   }
  },
  "quota": {
   "type": "object",
   "required": ["camps", "night_types", "estimate"],
   "additionalProperties": false,
   "properties": {
    "camps": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nights" } } },
    "night_types": {
     "type": "object",
     "required": ["weekend", "midweek", "labor_day"],
     "additionalProperties": false,
     "properties": {
      "weekend": { "$ref": "#/$defs/days" },
      "midweek": { "$ref": "#/$defs/days" },
      "labor_day": { "type": "object", "required": ["nights", "of_weekend"], "additionalProperties": false, "properties": { "nights": { "$ref": "#/$defs/days" }, "of_weekend": { "$ref": "#/$defs/p" } } }
     }
    },
    "estimate": { "const": true }
   }
  },
  "desk": {
   "type": "object",
   "required": ["p_granted", "weekend_nights", "holiday_sunday", "season", "m1a", "m1b", "phone_only", "estimate", "sources"],
   "additionalProperties": false,
   "properties": {
    "p_granted": { "$ref": "#/$defs/nights" },
    "weekend_nights": { "$ref": "#/$defs/days" },
    "holiday_sunday": { "type": "boolean" },
    "season": { "$ref": "#/$defs/mdRange" },
    "m1a": { "$ref": "#/$defs/ids" },
    "m1b": { "$ref": "#/$defs/ids" },
    "phone_only": { "$ref": "#/$defs/ids" },
    "estimate": { "const": true },
    "sources": { "$ref": "#/$defs/urls" }
   }
  },
  "rangers": {
   "type": "object",
   "required": ["camp_evening_visit", "on_trail", "permit_check", "estimate"],
   "additionalProperties": false,
   "properties": {
    "camp_evening_visit": {
     "type": "object",
     "required": ["camps", "weekend_nights"],
     "additionalProperties": false,
     "properties": { "camps": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nights" } }, "weekend_nights": { "$ref": "#/$defs/days" } }
    },
    "on_trail": {
     "type": "object",
     "required": ["per_hour", "evening_factor"],
     "additionalProperties": false,
     "properties": { "per_hour": { "type": "object", "additionalProperties": { "type": "object", "required": ["midweek", "weekend"], "additionalProperties": false, "properties": { "midweek": { "type": "number", "minimum": 0 }, "weekend": { "type": "number", "minimum": 0 } } } }, "evening_factor": { "$ref": "#/$defs/p" } }
    },
    "permit_check": { "type": "object", "required": ["after_citation_factor"], "additionalProperties": false, "properties": { "after_citation_factor": { "type": "number", "minimum": 1 } } },
    "estimate": { "const": true }
   }
  },
  "visitors": {
   "type": "object",
   "required": ["p_visitor_per_night", "p_bear_given_visitor", "canister_closed_factor", "estimate"],
   "additionalProperties": false,
   "properties": {
    "p_visitor_per_night": { "type": "object", "additionalProperties": { "$ref": "#/$defs/p" } },
    "p_bear_given_visitor": { "type": "object", "additionalProperties": { "$ref": "#/$defs/p" } },
    "canister_closed_factor": { "$ref": "#/$defs/p" },
    "estimate": { "const": true }
   }
  },
  "loaner": { "type": "object", "required": ["item", "always"], "additionalProperties": false, "properties": { "item": { "$ref": "#/$defs/id" }, "always": { "const": true } } },
  "sources": { "$ref": "#/$defs/urls" }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
  "urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
  "p": { "type": "number", "minimum": 0, "maximum": 1 },
  "nights": { "type": "object", "required": ["midweek", "weekend"], "additionalProperties": false, "properties": { "midweek": { "$ref": "#/$defs/p" }, "weekend": { "$ref": "#/$defs/p" } } },
  "days": { "type": "array", "minItems": 1, "items": { "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] } },
  "mdRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" } }
 }
}
