{
 "$comment": "content/quiz/locals.json: the lockbox's locals' quiz (BUILD_PLAN 3.4, S4; GAME_DESIGN 2.6, 12.3, E.5; F.3's quiz rule: a source and exactly one right answer each). Every word is a line by id (\"@first.lockbox...\"); right is the index of the one true answer among exactly three.",
 "type": "object",
 "required": ["deal", "rules", "right", "wrong", "questions"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "deal": { "type": "integer", "minimum": 1 },
  "rules": {
   "type": "object",
   "required": ["no_two_pronunciations_in_a_row", "everyone_gets_in", "never_again"],
   "additionalProperties": false,
   "properties": { "no_two_pronunciations_in_a_row": { "type": "boolean" }, "everyone_gets_in": { "type": "boolean" }, "never_again": { "type": "boolean" } }
  },
  "right": { "$ref": "#/$defs/line" },
  "wrong": { "$ref": "#/$defs/line" },
  "questions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "ask", "answers", "right", "pronunciation", "source"],
    "additionalProperties": false,
    "properties": {
     "id": { "type": "string", "pattern": "^q_[a-z0-9_]+$" },
     "ask": { "$ref": "#/$defs/line" },
     "answers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/line" } },
     "right": { "type": "integer", "minimum": 0, "maximum": 2 },
     "pronunciation": { "type": "boolean" },
     "indigenous_name": { "const": true },
     "source": {
      "type": "object",
      "required": ["url", "publisher"],
      "additionalProperties": false,
      "properties": { "url": { "type": "string", "pattern": "^https://" }, "publisher": { "type": "string", "minLength": 1 } }
     }
    }
   }
  }
 },
 "$defs": {
  "line": { "type": "string", "pattern": "^@[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$", "x-text": true, "x-voice": true }
 }
}
