{
 "$comment": "content/audio/credits.json: the license log (BUILD_PLAN 13.4; GAME_DESIGN 13.9, 13.12; decision 33), read by tools/listen.mjs loadAudio() (J01 through the audio reader). One entry per shipped sound. A synthesized one (S5 A1's four UI cues) names its recipe in content/audio/sounds.json and the code that makes it, and has no file; a recorded one (A3, S22) names its file, its source page, title and author, its CC0 or NPS public-domain license, the evidence and the date it was checked, any stand-in and what was changed, and both files' SHA-256. A01 to A09 land in S22; the schema holds from now on, and the build refuses a cue with no entry.",
 "type": "object",
 "required": ["sounds"],
 "additionalProperties": false,
 "properties": {
  "$comment": {"type": "string"},
  "sounds": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
 },
 "$defs": {
  "date": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
  "entry": {
   "oneOf": [
    {
     "$comment": "Synthesized: our own code, from its recipe (license synth).",
     "type": "object",
     "required": ["id", "file", "source", "recipe", "license", "author", "made_by", "checked", "uses"],
     "additionalProperties": false,
     "properties": {
      "$comment": {"type": "string"},
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
      "file": {"type": "null"},
      "source": {"const": "synth"},
      "recipe": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
      "license": {"const": "synth"},
      "author": {"type": "string", "minLength": 1},
      "made_by": {"type": "string", "pattern": "^web/js/audio/[a-z]+\\.js$"},
      "checked": {"$ref": "#/$defs/date"},
      "uses": {"$ref": "#/$defs/uses"}
     }
    },
    {
     "$comment": "A recording (A3): CC0 or US government public domain, with its evidence and hashes.",
     "type": "object",
     "required": ["id", "file", "source", "url", "title", "author", "license", "evidence", "checked", "changed", "sha256_master", "sha256_file", "uses"],
     "additionalProperties": false,
     "properties": {
      "$comment": {"type": "string"},
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
      "file": {"type": "string", "pattern": "^content/audio/enc/[a-z0-9_.-]+\\.m4a$"},
      "source": {"type": "string", "minLength": 1},
      "url": {"type": "string", "pattern": "^https://"},
      "title": {"type": "string", "minLength": 1},
      "author": {"type": "string", "minLength": 1},
      "license": {"enum": ["CC0-1.0", "nps-public-domain"]},
      "evidence": {"type": "string", "minLength": 1},
      "checked": {"$ref": "#/$defs/date"},
      "stand_in": {"type": "string", "minLength": 1},
      "changed": {"type": "string", "minLength": 1},
      "sha256_master": {"$ref": "#/$defs/sha256"},
      "sha256_file": {"$ref": "#/$defs/sha256"},
      "uses": {"$ref": "#/$defs/uses"}
     }
    }
   ]
  }
 }
}
