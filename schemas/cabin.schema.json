{
 "$comment": "content/home/cabin.json: the cabin at Lake Quinault (BUILD_PLAN S7; GAME_DESIGN 2.2, 11.11, 12.3). The plate, the hour's tables and the cabin's own remaps, the stamps web/js/gfx/cabin.js composes over it (skies, weather, lights, embers, smoke, states), the moon and the stars, the places with their boxes in picture pixels on the 160x320 plate, the rail, the hours rule, the sky's knobs, the next step's states and the porch frame's window. The lints that read it: J01 (this schema), P17 (the hit areas, labels, anchors and Z ops).",
 "type": "object",
 "required": ["plate", "season", "tables", "remaps", "skies", "weather", "lights", "embers", "smoke", "states", "moon", "stars", "places", "rail", "hours", "sky", "next", "first"],
 "additionalProperties": false,
 "properties": {
  "$comment": {"type": "string"},
  "plate": {"$ref": "#/$defs/id"},
  "season": {"enum": ["spring", "summer", "autumn", "winter"]},
  "tables": {
   "type": "object",
   "required": ["day", "dawn", "dusk", "blue", "night"],
   "additionalProperties": false,
   "properties": {
    "day": {"$ref": "#/$defs/table"},
    "dawn": {"$ref": "#/$defs/table"},
    "dusk": {"$ref": "#/$defs/table"},
    "blue": {"$ref": "#/$defs/table"},
    "night": {"$ref": "#/$defs/table"}
   }
  },
  "remaps": {
   "$comment": "The cabin's own palette tables, by name: sixteen slots each, slot to slot (web/js/gfx/palette.js REMAPS's shape); the hours' tables name them.",
   "type": "object",
   "required": ["cabin_day", "cabin_dusk", "cabin_blue", "cabin_night"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "cabin_day": {"$ref": "#/$defs/remap"},
    "cabin_dusk": {"$ref": "#/$defs/remap"},
    "cabin_blue": {"$ref": "#/$defs/remap"},
    "cabin_night": {"$ref": "#/$defs/remap"}
   }
  },
  "skies": {
   "type": "object",
   "required": ["clear", "cloudy", "rain"],
   "additionalProperties": false,
   "properties": {
    "clear": {"$ref": "#/$defs/id"},
    "cloudy": {"$ref": "#/$defs/id"},
    "rain": {"$ref": "#/$defs/id"}
   }
  },
  "weather": {
   "type": "object",
   "required": ["cloudy", "rain", "fog"],
   "additionalProperties": false,
   "properties": {
    "cloudy": {"$ref": "#/$defs/layered"},
    "rain": {"$ref": "#/$defs/layered"},
    "fog": {"$ref": "#/$defs/layered"}
   }
  },
  "lights": {"$ref": "#/$defs/overlays"},
  "embers": {"$ref": "#/$defs/overlays"},
  "smoke": {"$ref": "#/$defs/overlays"},
  "states": {
   "type": "object",
   "required": ["first", "guestbook", "flag_up"],
   "additionalProperties": false,
   "properties": {
    "first": {"$ref": "#/$defs/overlays"},
    "guestbook": {"$ref": "#/$defs/overlays"},
    "flag_up": {"$ref": "#/$defs/overlays"}
   }
  },
  "moon": {
   "type": "object",
   "required": ["at", "stamp", "new_moon_ms", "synodic_e5", "rise_min", "rise_per_day_min", "up_min"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "at": {"$ref": "#/$defs/id"},
    "stamp": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_$"},
    "new_moon_ms": {"type": "integer", "minimum": 0},
    "synodic_e5": {"type": "integer", "minimum": 2900000, "maximum": 3000000},
    "rise_min": {"type": "integer", "minimum": 0, "maximum": 1439},
    "rise_per_day_min": {"type": "integer", "minimum": 1, "maximum": 120},
    "up_min": {"type": "integer", "minimum": 1, "maximum": 1440}
   }
  },
  "stars": {
   "type": "object",
   "required": ["floor", "count", "dipper"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "floor": {"$ref": "#/$defs/id"},
    "count": {
     "type": "object",
     "required": ["blue", "night"],
     "additionalProperties": false,
     "properties": {
      "blue": {"$ref": "#/$defs/range"},
      "night": {"$ref": "#/$defs/range"}
     }
    },
    "dipper": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/point"}}
   }
  },
  "places": {"type": "object", "additionalProperties": {"$ref": "#/$defs/place"}},
  "rail": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
  "hours": {
   "type": "object",
   "required": ["sun_margin_s", "blue_outside_permille", "blue_inside_permille"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "sun_margin_s": {"type": "integer", "minimum": 0, "maximum": 7200},
    "blue_outside_permille": {"type": "integer", "minimum": 0, "maximum": 2000},
    "blue_inside_permille": {"type": "integer", "minimum": 0, "maximum": 1000}
   }
  },
  "sky": {
   "type": "object",
   "required": ["zone", "fog_until_s", "fog_permille"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "zone": {"$ref": "#/$defs/id"},
    "fog_until_s": {"type": "integer", "minimum": 0, "maximum": 86399},
    "fog_permille": {
     "type": "array",
     "minItems": 12,
     "maxItems": 12,
     "items": {
      "type": "object",
      "required": ["m", "permille", "estimate", "why"],
      "additionalProperties": false,
      "properties": {
       "m": {"type": "integer", "minimum": 1, "maximum": 12},
       "permille": {"type": "integer", "minimum": 0, "maximum": 1000},
       "estimate": {"type": "boolean"},
       "why": {"type": "string", "minLength": 1}
      }
     }
    }
   }
  },
  "next": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "lands", "doc"],
    "additionalProperties": false,
    "properties": {
     "id": {"$ref": "#/$defs/id"},
     "when": {"enum": ["no_finished_trip", "no_trip_under_way"]},
     "act": {"enum": ["start"]},
     "lands": {"$ref": "#/$defs/session"},
     "doc": {"type": "string", "minLength": 1}
    }
   }
  },
  "first": {
   "type": "object",
   "required": ["window_y", "window_h"],
   "additionalProperties": false,
   "properties": {
    "window_y": {"type": "integer", "minimum": 0, "maximum": 319},
    "window_h": {"type": "integer", "minimum": 1, "maximum": 320}
   }
  }
 },
 "$defs": {
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "session": {"type": "string", "pattern": "^(S[0-9]+[a-z]?|M[0-9]+[a-z]?|T[0-9]+)$"},
  "table": {"enum": ["cabin_day", "cabin_dusk", "cabin_blue", "cabin_night"]},
  "remap": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "integer", "minimum": 0, "maximum": 15}},
  "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 319}},
  "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 320}},
  "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 200}},
  "overlay": {
   "$comment": "A stamp the composer places: at an anchor of the plate (at_<at>), or at the plate's origin when at is absent; fx flips it left to right.",
   "type": "object",
   "required": ["stamp"],
   "additionalProperties": false,
   "properties": {
    "stamp": {"$ref": "#/$defs/id"},
    "at": {"$ref": "#/$defs/id"},
    "fx": {"type": "boolean"}
   }
  },
  "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}},
  "layered": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["layer", "stamp"],
    "additionalProperties": false,
    "properties": {
     "layer": {"enum": ["far", "mid", "near"]},
     "stamp": {"$ref": "#/$defs/id"},
     "at": {"$ref": "#/$defs/id"},
     "fx": {"type": "boolean"}
    }
   }
  },
  "place": {
   "type": "object",
   "required": ["kind", "art", "hit", "opens", "lands", "doc"],
   "additionalProperties": false,
   "properties": {
    "kind": {"enum": ["place", "look", "silent", "first"]},
    "art": {"$ref": "#/$defs/box"},
    "hit": {"$ref": "#/$defs/box"},
    "label": {"$ref": "#/$defs/point"},
    "align": {"enum": ["left", "center", "right"]},
    "rail": {"$ref": "#/$defs/id"},
    "opens": {"$ref": "#/$defs/id"},
    "lands": {"$ref": "#/$defs/session"},
    "doc": {"type": "string", "minLength": 1}
   }
  }
 }
}
