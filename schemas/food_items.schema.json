{
 "$comment": "content/food/items.json: the food catalog as the game reads it, generated by tools/ingest.mjs (tools/ingest/catalogs.mjs; BUILD_PLAN 2.6, S4; GAME_DESIGN 5.4, 5.7, 5.8). Never hand-edited. No names, units or notes: words stay in design/data. origin lists the counters whose shelves carry each food.",
 "type": "object",
 "required": ["format", "foods"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "format": { "const": 1 },
  "foods": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["calories", "weight_oz", "volume_l", "volume_repacked_l", "price_usd", "basic", "prep", "fuel_g", "water_l", "morale", "tags", "spoils_days", "crushable", "needs", "sold_at", "origin"],
    "additionalProperties": false,
    "properties": {
     "calories": { "type": "number", "minimum": 0 },
     "weight_oz": { "type": "number", "minimum": 0 },
     "volume_l": { "type": "number", "minimum": 0 },
     "volume_repacked_l": { "type": "number", "minimum": 0 },
     "price_usd": { "type": "number", "minimum": 0 },
     "basic": { "type": "boolean" },
     "prep": { "enum": ["no_cook", "boil", "cold_soak", "fresh"] },
     "fuel_g": { "type": "number", "minimum": 0 },
     "water_l": { "type": "number", "minimum": 0 },
     "morale": { "type": "integer", "minimum": -2, "maximum": 3 },
     "tags": { "$ref": "#/$defs/ids" },
     "spoils_days": { "type": ["integer", "null"] },
     "crushable": { "type": "boolean" },
     "needs": { "$ref": "#/$defs/ids" },
     "sold_at": { "$ref": "#/$defs/ids" },
     "kcal_per_oz": { "type": "number" },
     "kcal_per_l": { "type": "number" },
     "age_min": { "type": "integer" },
     "requires_flag": { "$ref": "#/$defs/id" },
     "event_tags": { "$ref": "#/$defs/ids" },
     "overnight_only": { "type": "boolean" },
     "smellable": { "type": "boolean" },
     "empty": { "type": "object", "required": ["weight_oz", "volume_l", "pack_out"], "additionalProperties": false, "properties": { "weight_oz": { "type": "number" }, "volume_l": { "type": "number" }, "pack_out": { "type": "boolean" } } },
     "estimate": { "const": true },
     "origin": { "type": "array", "items": { "enum": ["general", "gear", "desk"] } }
    }
   }
  }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
 }
}
