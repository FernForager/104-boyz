{
 "$comment": "content/park/overlays/<region>.json: hand patches only where the research is silent (BUILD_PLAN 2.6, 3.4; GAME_DESIGN 4.3, 7.4, E.5). Every patch names its doc or its evidence. loops and forks are read by the build (rules.park); presets, nodes and segments are applied by ingest.",
 "type": "object",
 "required": ["loops", "forks", "presets", "nodes", "segments"],
 "additionalProperties": false,
 "properties": {
  "$comment": { "type": "string" },
  "loops": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["trailhead", "ccw_first", "cw_first", "crest_via", "basin_via", "doc"],
    "additionalProperties": false,
    "properties": {
     "trailhead": { "$ref": "#/$defs/id" },
     "ccw_first": { "$ref": "#/$defs/seg_id" },
     "cw_first": { "$ref": "#/$defs/seg_id" },
     "crest_via": { "$ref": "#/$defs/id" },
     "basin_via": { "$ref": "#/$defs/id" },
     "doc": { "$ref": "#/$defs/doc" }
    }
   }
  },
  "forks": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["kind", "dir", "way_in", "doc"],
    "additionalProperties": false,
    "properties": {
     "kind": { "enum": ["basin_or_crest"] },
     "dir": { "enum": ["ccw", "cw"] },
     "way_in": { "$ref": "#/$defs/seg_id" },
     "doc": { "$ref": "#/$defs/doc" }
    }
   }
  },
  "presets": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["days"],
    "additionalProperties": false,
    "properties": {
     "days": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": ["via", "doc"],
       "additionalProperties": false,
       "properties": { "via": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "doc": { "$ref": "#/$defs/doc" } }
      }
     }
    }
   }
  },
  "nodes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["source"],
    "additionalProperties": false,
    "properties": {
     "elev_ft": { "type": "integer" },
     "elev_est": { "type": "boolean" },
     "source": { "$ref": "#/$defs/doc" }
    }
   }
  },
  "segments": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["source"],
    "additionalProperties": false,
    "properties": {
     "snow_free_doy": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1, "maximum": 366 } } },
     "source": { "$ref": "#/$defs/doc" }
    }
   }
  }
 },
 "$defs": {
  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
  "seg_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*->[a-z][a-z0-9_]*$" },
  "doc": { "type": "string", "minLength": 1 }
 }
}
